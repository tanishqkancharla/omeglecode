{
  "name": "omeglecode",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "check": "tsc --noEmit && pnpm -r check",
    "dev": "pnpm --filter @omeglecode/worker dev",
    "infra:deploy": "alchemy deploy",
    "infra:dev": "alchemy dev",
    "plugin:link": "sh scripts/link.sh",
    "spec": "tkstack",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "alchemy": "2.0.0-beta.74",
    "effect": "4.0.0-rc.112",
    "tkstack": "latest",
    "typescript": "^5.9.2"
  }
}
