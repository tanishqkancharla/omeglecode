{
  "name": "pi-omeglecode",
  "version": "0.5.0",
  "description": "Anonymous Omeglecode hallway above the Pi prompt. Same Worker as OpenCode.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tanishqkancharla/omeglecode.git",
    "directory": "packages/pi"
  },
  "homepage": "https://github.com/tanishqkancharla/omeglecode#readme",
  "bugs": "https://github.com/tanishqkancharla/omeglecode/issues",
  "keywords": [
    "pi-package",
    "pi-extension",
    "omeglecode",
    "chat"
  ],
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=node --outfile=dist/index.js --external:@earendil-works/pi-coding-agent --external:@earendil-works/pi-tui",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@omeglecode/client": "workspace:*",
    "@omeglecode/protocol": "workspace:*",
    "@types/node": "^22.13.0",
    "esbuild": "latest",
    "typescript": "^5.9.2",
    "vitest": "latest"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
