{
  "name": "opencode-omeglecode",
  "version": "0.4.2",
  "description": "Real-time anonymous group chat in the OpenCode v2 sidebar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tanishqkancharla/omeglecode.git"
  },
  "homepage": "https://github.com/tanishqkancharla/omeglecode#readme",
  "bugs": "https://github.com/tanishqkancharla/omeglecode/issues",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "chat",
    "tui"
  ],
  "type": "module",
  "bin": {
    "omeglecode": "./dist/install.js"
  },
  "exports": {
    ".": "./dist/package.js",
    "./tui": {
      "default": "./dist/tui.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "opencode": ">=0.0.0-beta-18414"
  },
  "scripts": {
    "build": "pnpm --filter pi-omeglecode build && esbuild src/tui.tsx --bundle --format=esm --platform=node --jsx=automatic --jsx-import-source=@opentui/solid --outfile=dist/tui.js --external:@opencode-ai/plugin --external:@opentui/core --external:@opentui/solid --external:solid-js && cp package.js install.js ../pi/dist/index.js dist/ && mv dist/index.js dist/pi-omeglecode.js",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@omeglecode/client": "workspace:*",
    "@omeglecode/protocol": "workspace:*",
    "@opencode-ai/plugin": "0.0.0-beta-18414",
    "@opencode-ai/theme": "0.0.0-beta-18414",
    "@opentui/core": "0.5.8",
    "@opentui/keymap": "0.5.8",
    "@opentui/solid": "0.5.8",
    "esbuild": "latest",
    "solid-js": "1.9.12",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.8",
    "@opentui/solid": ">=0.5.8",
    "solid-js": ">=1.9.0"
  }
}
